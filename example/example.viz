          "visibility": "+",
          "name": "placeOrder",
          "signature": "(items: LineItem[])",
          "returnType": "Order",
          "parameters": [
            {
              "id": "cust-op-1-p1",
              "name": "items",
              "type": "LineItem[]"
            }
          ]
        }
      ]
    },
    {
      "id": "order",
