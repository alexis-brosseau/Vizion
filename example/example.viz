          "type": "string"
        },
        {
          "id": "order-attr-2",
          "visibility": "-",
          "name": "totalCents",
          "type": "number"
        },
        {
          "id": "order-attr-3",
          "visibility": "+",
          "name": "status",
          "type": "OrderStatus"
        }
      ],
      "operations": [
        {
          "id": "order-op-1",
          "visibility": "+",
          "name": "calculateTotal",
          "signature": "()",
          "returnType": "number",
          "parameters": []
        },
        {
          "id": "order-op-2",
          "visibility": "+",
          "name": "submitPayment",
          "signature": "(methodId: string)",
          "returnType": "Promise<boolean>",
          "parameters": [
            {
              "id": "order-op-2-p1",
              "name": "methodId",
