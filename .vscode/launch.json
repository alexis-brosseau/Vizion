{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vizion Extension (Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}

